# Enquiry delivery. Copy to .env.local for local work; set the same keys in
# the Vercel project (Production + Preview). Never commit real values.
#
# Leave ENQUIRY_PROVIDER unset and the enquiry form still works: submissions
# are written to the server log and the form tells the visitor it was
# recorded rather than emailed, pointing them at phone and WhatsApp.

# Delivery provider. Only "smtp" is implemented.
ENQUIRY_PROVIDER=smtp

# Zoho Mail SMTP, authenticated as the company mailbox. Sending through Zoho
# means the message is DKIM-signed by the domain and comes from an IP the
# domain's SPF record authorises, so it passes DMARC and lands in the inbox
# instead of the junk folder.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=sales@standardautomations.in

# An app-specific password generated in Zoho (Profile > Security > App
# Passwords) — NOT the account password. Never commit this.
SMTP_PASSWORD=

# Where enquiries are delivered. Defaults to siteConfig.email.
ENQUIRY_TO=sales@standardautomations.in

# Sender shown on the enquiry. Must be the authenticated mailbox or one of
# its aliases, otherwise Zoho will refuse to send it.
ENQUIRY_FROM="Standard Automation Website <sales@standardautomations.in>"
